{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Day Planner",
  "version": "0.1.0",
  "identifier": "com.dayplanner.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      { "label": "main", "title": "Day Planner", "url": "index.html", "width": 1200, "height": 800, "backgroundColor": "#121212" },
      { "label": "widget", "title": "Widget", "url": "index.html?widget=1", "width": 300, "height": 300, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "backgroundColor": "#1c1c1e" }
    ]
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
